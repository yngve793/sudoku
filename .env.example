# ---------------------------------------------------------------------------
# Shared settings. Used by both `uv run uvicorn ...` and `docker compose`.
# NOTE: DATABASE_URL, CORS_ORIGINS, FRONTEND_URL and SMTP_* below are for the
# NON-Docker setup only; docker-compose.yml sets its own values for those.
# ---------------------------------------------------------------------------
# Backend
DATABASE_URL=sqlite:///./sudoku.db
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Email (Mailpit in dev: smtp on 1025, web UI on 8025)
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=Sudoku <no-reply@sudoku.local>
# Puzzle pool
POOL_TARGET_PER_LEVEL=20
POOL_REFILL_INTERVAL_SECONDS=30
# Backend (additional, all optional; defaults shown)
VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_MINUTES=60
COOKIE_SAMESITE=strict
# Rate limits (slowapi/limits syntax). RATE_LIMIT_STORAGE_URI may be redis://... in prod.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
AUTH_RATE_LIMIT=20/minute
# /auth/refresh and /auth/logout: separate, looser bucket (every page load refreshes)
REFRESH_RATE_LIMIT=60/minute
EMAIL_RATE_LIMIT=3/hour
HINT_RATE_LIMIT=30/minute
# POST /games/{id}/search/propagate (search mode, auto implications)
SEARCH_RATE_LIMIT=120/minute
# Puzzle source: generator (default) or fixture (built-in sample puzzles, tests/dev)
PUZZLE_SOURCE=generator
# Generator worker processes (0 = run in a thread)
GENERATOR_PROCESSES=2
# Timeout for on-demand generation in POST /games when the pool is empty
GENERATION_TIMEOUT_SECONDS=5
# Per-puzzle timeout for background pool refills
POOL_GENERATION_TIMEOUT_SECONDS=120
POOL_WORKER_ENABLED=true
LEADERBOARD_CACHE_SECONDS=30
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------------------
# Docker compose only (see docker-compose.yml; defaults shown)
# ---------------------------------------------------------------------------
# Host port of the app (nginx; the only public entry point)
APP_PORT=8080
# Public URL of the app; used for email links and CORS in the compose stack.
# Defaults to http://localhost:${APP_PORT}; set it only behind a proxy/other host.
# APP_URL=http://localhost:8080
# Host port of the Mailpit web UI/API (bound to 127.0.0.1 only)
MAILPIT_PORT=8025
POSTGRES_USER=sudoku
POSTGRES_PASSWORD=sudoku
POSTGRES_DB=sudoku
# Host port for connecting DB tools to Postgres (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
# Image tags built/used by compose (dev override: FRONTEND_DEV_IMAGE=sudoku-frontend:dev)
API_IMAGE=sudoku-api:local
FRONTEND_IMAGE=sudoku-frontend:local
# Subnet of the `edge` (nginx <-> api) network; also the api's FORWARDED_ALLOW_IPS.
# Keep it outside Docker's default pools (172.17-31.x, 192.168.x).
EDGE_SUBNET=10.89.28.0/24
# A second, isolated instance on the same host (e.g. scripts/verify.sh --docker) must
# override API_IMAGE, FRONTEND_IMAGE, APP_PORT, MAILPIT_PORT, POSTGRES_PORT and
# EDGE_SUBNET, and use its own project name (-p), so it neither retags the user's
# images nor collides on host ports or the subnet.
# `docker compose --profile tools run --rm seed` pre-fills the puzzle pool
SEED_LEVELS=master extreme
SEED_COUNT=20
SEED_WORKERS=2
