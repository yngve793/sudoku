# Set to "true" to run the dev server against in-browser MSW mocks instead of the backend.
VITE_USE_MOCKS=false

# Dev server only: where Vite proxies /api (default http://localhost:8000).
# E.g. http://api:8000 when the dev server runs inside docker-compose.
# Not used by `npm run build`; the production image proxies /api in nginx.
VITE_API_PROXY_TARGET=http://localhost:8000
